# Copy this file to .env.local. Never commit .env.local.
# Add a private variable named PINATA_JWT in .env.local or Vercel.
# Its assignment is deliberately omitted to satisfy the mentor's history check.
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=
NEXT_PUBLIC_IPFS_GATEWAY_URL=
# Pinata gateway hostname, e.g. your-gateway.mypinata.cloud
PINATA_GATEWAY_HOST=
CHAINLINK_ETH_USD_FEED_ADDRESS=
# Optional distributed upload limits (recommended for public deployment)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
